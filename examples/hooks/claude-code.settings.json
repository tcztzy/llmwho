{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "llmwho",
            "args": ["hook", "claude-code", "--event", "SessionStart"],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "llmwho",
            "args": ["hook", "claude-code", "--event", "UserPromptSubmit"],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "llmwho",
            "args": ["hook", "claude-code", "--event", "Stop"],
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "llmwho",
            "args": ["hook", "claude-code", "--event", "StopFailure"],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "llmwho",
            "args": ["hook", "claude-code", "--event", "SessionEnd"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
