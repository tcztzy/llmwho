{
  "name": "llmwho",
  "version": "0.1.0",
  "description": "Passive LLM endpoint identity and stability instrumentation",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "llmwho": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "llm",
    "observability",
    "fingerprinting",
    "stability",
    "middleware"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tcztzy/llmwho.git"
  },
  "bugs": {
    "url": "https://github.com/tcztzy/llmwho/issues"
  },
  "homepage": "https://github.com/tcztzy/llmwho#readme",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
